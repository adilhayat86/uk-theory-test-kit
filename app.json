{
  "expo": {
    "name": "Driving Theory Test UK: Learn",
    "slug": "uk-theory-test-kit",
    "version": "0.6.0",
    "description": "Independent offline revision questions for Great Britain car learners. Not affiliated with DVSA.",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adilhayat.uktheorytestkit"
    },
    "android": {
      "package": "com.adilhayat.uktheorytestkit",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/brand/adaptive-icon.png",
        "backgroundImage": "./src/assets/brand/adaptive-background.png",
        "backgroundColor": "#F7F7F2"
      }
    },
    "icon": "./src/assets/brand/app-icon.png"
  }
}
